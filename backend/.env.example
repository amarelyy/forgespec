PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://forgespec:forgespec@localhost:5432/forgespec
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173

# Local object storage (stand-in for S3/MinIO): backups and exports
STORAGE_DIR=./storage-data
EXPORT_TTL_HOURS=24

# Distributor API: "mock" (built-in fixture catalogue) or "nexar" (Octopart)
DISTRIBUTOR_PROVIDER=mock
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
